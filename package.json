{
  "name": "aws-bedrock-software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "AWS Software Factory Blueprint using Amazon Bedrock AgentCore Harness and AWS Lambda Durable Functions",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "simulate": "pnpm --filter @software-factory/orchestrator run simulate",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^3.24.2"
  }
}
